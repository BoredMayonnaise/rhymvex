# Copy to web/.env.local and fill in. Never commit real values.
# Phase 1 handoff: these are filled in after the domain + accounts exist.
# See docs/phases/phase-1-foundation.md → Handoff checklist.

# Canonical site origin. Used for metadata, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://rhymvex.space

# Where "Start your project" and the audit CTA point.
# Until a calendar tool is chosen, the CTAs fall back to in-site intake.
NEXT_PUBLIC_CONTACT_EMAIL=support@rhymvex.space

# Optional booking link (e.g. Calendly, Cal.com). Leave empty until a calendar
# tool is set up. Set this before launch for best conversion.
NEXT_PUBLIC_CALENDAR_URL=

# ==============================================================================
# DATABASE
# ==============================================================================
# Local Docker Postgres (docker compose up -d). Never commit a production URL.
DATABASE_URL=postgres://rhymvex:rhymvex_dev@localhost:5435/rhymvex

# ==============================================================================
# SESSION / CSRF
# ==============================================================================
# 32+ random bytes, base64url. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, the app refuses to start outside development.
SESSION_SECRET=

# ==============================================================================
# DUAL-CHANNEL SMTP CONFIGURATION
# ==============================================================================
# Rhymvex uses two concurrent SMTP transports:
# 1. Zoho Business Email: Client confirmations, portal invitations, outbound proposals.
# 2. Google / Gmail: Team invitations, new lead notices with live pipeline stats, system alerts.
#
# Interactive setup tool:
#   npm run mail:app
# Verify both connections:
#   npm run mail:verify
#
# --- CHANNEL 1: ZOHO BUSINESS EMAIL (Client-Facing & Outbound) ---
# Requires Zoho Application-Specific Password (accounts.zoho.com -> Security)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=support@rhymvex.space
ZOHO_SMTP_PASSWORD=
ZOHO_SMTP_FROM=Rhymvex <support@rhymvex.space>

# --- CHANNEL 2: GOOGLE / GMAIL (Background Team, Leads & Error Alerts) ---
# Requires 16-character Google App Password (myaccount.google.com/apppasswords)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_FROM=Rhymvex System <no-reply@rhymvex.space>

# --- NOTIFICATION DESTINATION ---
# Where internal lead notices (with live pipeline counts) and error alerts are delivered:
INTERNAL_NOTIFICATION_EMAIL=support@rhymvex.space

# --- OPTIONAL UNIFIED FALLBACK ---
# If ZOHO_* or GMAIL_* are omitted, they fall back to standard SMTP_* if configured:
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Rhymvex <support@rhymvex.space>

# ==============================================================================
# INTAKE
# ==============================================================================
# Requests per IP per window on the public intake endpoint. Over the limit the
# request is rejected rather than silently dropped.
INTAKE_RATE_LIMIT=5
INTAKE_RATE_WINDOW_SECONDS=3600
# Minimum seconds between submissions from one IP. Honeypot + timing both help.
INTAKE_MIN_SECONDS=3

# ==============================================================================
# SIGN-IN THROTTLING
# ==============================================================================
# Two budgets, both on the staff and client sign-in forms. The per-IP one is
# consumed on every attempt and is deliberately loose: it is here to cap how
# many password hashes the server will compute and to blunt spraying across
# many accounts from one address, and a shared office puts several real people
# behind a single IP. Raise it before you expect it to bite.
SIGN_IN_IP_LIMIT=20
# The per-account budget is the one that stops guessing. It is keyed on a hash
# of the submitted email, so changing address does not reset it, and it is only
# consumed on a failed attempt, so a real user is never locked out by signing in
# successfully. Both budgets share this window.
SIGN_IN_ACCOUNT_LIMIT=5
SIGN_IN_WINDOW_SECONDS=900

# Only send a response-time promise if a real SLA is configured. Empty means
# the success screen deliberately makes no timing promise.
RESPONSE_SLA_MINUTES=
